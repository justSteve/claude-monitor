{
  "weights": {
    "bm25": 0.4,
    "semantic": 0.4,
    "curated": 0.405,
    "entity": 0.2
  },
  "timeoutMs": 2000,
  "defaultLimit": 10,
  "maxLimit": 100,
  "decay": {
    "enabled": true,
    "schedule": "0 3 * * *",
    "tiers": {
      "fast": {
        "summary": 14,
        "oneliner": 30,
        "archive": 90
      },
      "slow": {
        "summary": 60,
        "oneliner": 120,
        "archive": 180
      }
    },
    "salience": true
  },
  "promotion": {
    "enabled": true,
    "strike_threshold": 3,
    "min_days_spread": 3,
    "categories": [
      "preference",
      "convention",
      "antipattern",
      "tooling"
    ],
    "auto_write_rules": false
  },
  "curated": {
    "refreshSeconds": 60,
    "bundles": [
      "/root/projects/COO/conventions",
      "/root/projects/Strader/knowledge"
    ],
    "autoMemoryParent": "/root/.claude/projects",
    "exclude": [
      "zepo-prompts"
    ]
  }
}